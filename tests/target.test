package require tcltest
namespace import ::tcltest::*
source [file join [file dirname [info script]] .. lib label.tcl]
source [file join [file dirname [info script]] .. lib rules.tcl]
source [file join [file dirname [info script]] .. lib target.tcl]

proc reset {} {
    set ::tuck::graph::rules {}
    set ::tuck::graph::targets {}
    set ::tuck::_current_pkg ""
    proc ::tuck::_install_ctor {name} {}
}

test register-target {registers a node with canonical label} -setup {
    reset
    ::tuck::register_rule genrule {
        attrs {name {type string mandatory true}
               srcs {type sources mandatory true}}
    }
    set ::tuck::_current_pkg tools/hello
} -body {
    ::tuck::register_target genrule {name hello srcs {main.c}}
    dict get $::tuck::graph::targets //tools/hello:hello
} -result {label //tools/hello:hello rule genrule attrs {name hello srcs main.c} package tools/hello deps {}}

test extract-deps {deps attr is canonicalized into the dep set} -setup {
    reset
    ::tuck::register_rule lib {
        attrs {name {type string mandatory true}
               deps {type deps mandatory false default {}}}
    }
    set ::tuck::_current_pkg app
} -body {
    ::tuck::register_target lib {name a deps {//lib:util :other}}
    dict get $::tuck::graph::targets //app:a deps
} -result {//lib:util //app:other}

test dup-label {duplicate label errors} -setup {
    reset
    ::tuck::register_rule lib {attrs {name {type string mandatory true}}}
    set ::tuck::_current_pkg p
} -body {
    ::tuck::register_target lib {name a}
    catch {::tuck::register_target lib {name a}} err
    string match "tuck: duplicate target label: //p:a" $err
} -result 1

test bad-name {target names that could escape tuck-out are rejected} -setup {
    reset
    ::tuck::register_rule lib {attrs {name {type string mandatory true}}}
    set ::tuck::_current_pkg p
} -body {
    lmap n {x__/../../../../outside a/b a:b . .. {a b} {}} {
        catch {::tuck::register_target lib [list name $n]} err
        set err
    }
} -result [list \
    {tuck: invalid target name 'x__/../../../../outside' in //p} \
    {tuck: invalid target name 'a/b' in //p} \
    {tuck: invalid target name 'a:b' in //p} \
    {tuck: invalid target name '.' in //p} \
    {tuck: invalid target name '..' in //p} \
    {tuck: invalid target name 'a b' in //p} \
    {tuck: invalid target name '' in //p}]

test good-names {ordinary target names are accepted} -setup {
    reset
    ::tuck::register_rule lib {attrs {name {type string mandatory true}}}
    set ::tuck::_current_pkg p
} -body {
    foreach n {hello lib_util foo.bar a-b c++ v1.2} {
        ::tuck::register_target lib [list name $n]
    }
    dict keys $::tuck::graph::targets
} -result {//p:hello //p:lib_util //p:foo.bar //p:a-b //p:c++ //p:v1.2}

cleanupTests
