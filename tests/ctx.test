package require tcltest
namespace import ::tcltest::*
foreach m {label rules action ctx} {
    source [file join [file dirname [info script]] .. lib $m.tcl]
}

# A genrule schema and a target node to act as ctx.
proc setup_ctx {} {
    set ::tuck::graph::rules {}
    set ::tuck::graph::artifacts {}
    set ::tuck::graph::actions {}
    set ::tuck::graph::target_outputs {}
    set ::tuck::graph::_action_counter {}
    set ::tuck::graph::producers {}
    dict set ::tuck::graph::rules genrule [dict create schema {
        name {type string  mandatory true}
        srcs {type sources mandatory true}
        out  {type string  mandatory true}
        cmd  {type string  mandatory true}
        deps {type deps    mandatory false default {}}
    } impl __tuck_impl_genrule]
}

proc app_node {} {
    return [dict create label //app:hello rule genrule package app \
        attrs {name hello srcs {main.c util.c} out hello cmd {cc -o hello} deps {//lib:util}} \
        deps {//lib:util}]
}

test attr-sources {sources resolve to source artifact ids} -setup {setup_ctx} -body {
    ::tuck::ctx::attr [app_node] srcs
} -result {source:app/main.c source:app/util.c}

test attr-deps {deps resolve to canonical labels} -setup {setup_ctx} -body {
    ::tuck::ctx::attr [app_node] deps
} -result {//lib:util}

test attr-scalar {scalar attrs return the raw value} -setup {setup_ctx} -body {
    ::tuck::ctx::attr [app_node] name
} -result {hello}

test attr-unknown {unknown attr key errors} -setup {setup_ctx} -body {
    catch {::tuck::ctx::attr [app_node] bogus} err
    string match "tuck: ctx attr: no attribute 'bogus'" $err
} -result 1

test label-package {ctx label and ctx package} -setup {setup_ctx} -body {
    list [::tuck::ctx::label [app_node]] [::tuck::ctx::package [app_node]]
} -result {//app:hello app}

test declare-output {declares an artifact and records it under the target} -setup {setup_ctx} -body {
    set id [::tuck::ctx::declare_output [app_node] hello]
    list $id [dict get $::tuck::graph::target_outputs //app:hello]
} -result {declared://app:hello:hello declared://app:hello:hello}

test dep-outputs {returns a dependency's declared outputs} -setup {
    setup_ctx
    dict set ::tuck::graph::target_outputs //lib:util {declared://lib:util:util.o}
} -body {
    ::tuck::ctx::dep_outputs [app_node] //lib:util
} -result {declared://lib:util:util.o}

test dep-outputs-unanalysed {dep_outputs on an unanalysed label errors} -setup {setup_ctx} -body {
    catch {::tuck::ctx::dep_outputs [app_node] //nope:x} err
    string match "tuck: ctx dep_outputs: //nope:x has no analysed outputs" $err
} -result 1

test action-registers {ctx action registers a node and returns its id} -setup {setup_ctx} -body {
    set in  [::tuck::graph::register_source app/main.c]
    set out [::tuck::ctx::declare_output [app_node] hello]
    set id [::tuck::ctx::action [app_node] inputs [list $in] outputs [list $out] cmd {cc}]
    list $id [dict get $::tuck::graph::actions $id inputs] \
             [dict get $::tuck::graph::actions $id env]
} -result {//app:hello#0 source:app/main.c {}}

test action-missing-arg {ctx action requires inputs/outputs/cmd} -setup {setup_ctx} -body {
    catch {::tuck::ctx::action [app_node] inputs {a} outputs {b}} err
    string match "tuck: ctx action: missing cmd" $err
} -result 1

test dispatch-forwards {ctx dispatch forwards a subcommand to its accessor} -setup {setup_ctx} -body {
    ::tuck::ctx::dispatch [app_node] attr name
} -result {hello}

test dispatch-unknown {an unknown subcommand errors} -setup {setup_ctx} -body {
    catch {::tuck::ctx::dispatch [app_node] bogus} err
    string match "tuck: ctx: unknown subcommand 'bogus'" $err
} -result 1

test ctx-unbound {ctx errors before analysis binds a node} -setup {
    set i [interp create]
    ::tuck::ctx::install $i
} -body {
    catch {$i eval {ctx attr name}} err
    string match "tuck: ctx: no target bound*" $err
} -cleanup {
    interp delete $i
} -result 1

test ctx-path {ctx path returns an artifact's exec path} -setup {setup_ctx} -body {
    set out [::tuck::ctx::declare_output [app_node] build/hello]
    ::tuck::ctx::dispatch [app_node] path $out
} -result {tuck-out/app/__hello__/build/hello}

test declare-output-private {private outputs are registered but not published} -setup {setup_ctx} -body {
    set id [::tuck::ctx::declare_output [app_node] build/main.o -private]
    list $id [dict exists $::tuck::graph::artifacts $id] \
        [dict exists $::tuck::graph::target_outputs //app:hello]
} -result {declared://app:hello:build/main.o 1 0}

test declare-output-bad-option {unknown options are rejected} -setup {setup_ctx} -body {
    catch {::tuck::ctx::declare_output [app_node] x -bogus} err
    set err
} -result {tuck: ctx declare_output: unknown option '-bogus'}

foreach {n bad} {1 {} 2 /abs 3 ../up 4 a/../b 5 a//b 6 ./a 7 dir/} {
    test declare-output-invalid-$n "invalid path '$bad' is rejected" -setup {setup_ctx} -body {
        catch {::tuck::ctx::declare_output [app_node] $bad} err
        set err
    } -result "tuck: ctx declare_output: invalid path '$bad'"
}

test action-unknown-artifact {inputs must be registered artifacts} -setup {setup_ctx} -body {
    set out [::tuck::ctx::declare_output [app_node] hello]
    catch {::tuck::ctx::action [app_node] inputs {build/x.o} outputs [list $out] cmd {cc}} err
    set err
} -result {tuck: ctx action: unknown artifact 'build/x.o'}

test action-foreign-output {outputs must be declared by this target} -setup {setup_ctx} -body {
    set src [::tuck::graph::register_source app/main.c]
    set other [::tuck::graph::register_declared //lib:util util.o]
    catch {::tuck::ctx::action [app_node] inputs {} outputs [list $src] cmd {cc}} m1
    catch {::tuck::ctx::action [app_node] inputs {} outputs [list $other] cmd {cc}} m2
    list $m1 $m2
} -result {{tuck: ctx action: source:app/main.c is not an output of //app:hello} {tuck: ctx action: declared://lib:util:util.o is not an output of //app:hello}}

foreach {n w} {1 >out 2 2>@1 3 <in 4 | 5 >>log} {
    test action-redirect-$n "cmd word '$w' is rejected" -setup {setup_ctx} -body {
        set out [::tuck::ctx::declare_output [app_node] hello]
        catch {::tuck::ctx::action [app_node] inputs {} outputs [list $out] cmd [list cc $w]} err
        set err
    } -result "tuck: ctx action: cmd word '$w' would be read as a redirection by exec; wrap the command in sh -c"
}

test action-background {a trailing & is rejected} -setup {setup_ctx} -body {
    set out [::tuck::ctx::declare_output [app_node] hello]
    catch {::tuck::ctx::action [app_node] inputs {} outputs [list $out] cmd {cc &}} err
    set err
} -result {tuck: ctx action: cmd word '&' would be read as a redirection by exec; wrap the command in sh -c}

test action-sh-c-ok {redirections inside an sh -c script are fine} -setup {setup_ctx} -body {
    set out [::tuck::ctx::declare_output [app_node] hello]
    ::tuck::ctx::action [app_node] inputs {} outputs [list $out] cmd {sh -c {echo hi > x}}
} -result {//app:hello#0}

cleanupTests
