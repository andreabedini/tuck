package require tcltest
namespace import ::tcltest::*

# Guards the shipped example/ repo: its target and action graphs must keep
# matching what README.md documents. If the analyze output format changes,
# this fails and the README needs updating too.

set here    [file dirname [info script]]
set tuckbin [file normalize [file join $here .. tuck.tcl]]
set exampledir [file normalize [file join $here .. example]]

# Run tuck.tcl from inside example/; return {code stdout}.
proc run_example {args} {
    set code [catch {
        exec [info nameofexecutable] $::tuckbin {*}$args
    } out]
    return [list $code $out]
}

test example-targets {//... lists both example targets} -setup {
    set ::savedpwd [pwd]
    cd $::exampledir
} -cleanup {
    cd $::savedpwd
} -body {
    lassign [run_example targets //...] code out
    if {$code != 0} { error "exit $code: $out" }
    set out
} -result "//app:hello\n//lib/greet:greet"

test example-query-deps {dependency closure is leaves-first} -setup {
    set ::savedpwd [pwd]
    cd $::exampledir
} -cleanup {
    cd $::savedpwd
} -body {
    lassign [run_example query deps //app:hello] code out
    if {$code != 0} { error "exit $code: $out" }
    set out
} -result "//lib/greet:greet\n//app:hello"

test example-analyze {action graph matches README} -setup {
    set ::savedpwd [pwd]
    cd $::exampledir
} -cleanup {
    cd $::savedpwd
} -body {
    lassign [run_example analyze //app:hello] code out
    if {$code != 0} { error "exit $code: $out" }
    set out
} -result "//lib/greet:greet#0
  inputs:  source:lib/greet/greet.c source:lib/greet/greet.h
  outputs: declared://lib/greet:greet:build/greet.o
  cmd:     cc -Ilib/greet -c lib/greet/greet.c -o tuck-out/lib/greet/__greet__/build/greet.o
//lib/greet:greet#1
  inputs:  source:lib/greet/greet.h
  outputs: declared://lib/greet:greet:include/greet.h
  cmd:     cp lib/greet/greet.h tuck-out/lib/greet/__greet__/include/greet.h
//lib/greet:greet#2
  inputs:  declared://lib/greet:greet:build/greet.o
  outputs: declared://lib/greet:greet:build/libgreet.a
  cmd:     ar rcs tuck-out/lib/greet/__greet__/build/libgreet.a tuck-out/lib/greet/__greet__/build/greet.o
//app:hello#0
  inputs:  source:app/main.c declared://lib/greet:greet:include/greet.h
  outputs: declared://app:hello:build/main.o
  cmd:     cc -Ituck-out/lib/greet/__greet__/include -c app/main.c -o tuck-out/app/__hello__/build/main.o
//app:hello#1
  inputs:  declared://app:hello:build/main.o declared://lib/greet:greet:build/libgreet.a
  outputs: declared://app:hello:build/hello
  cmd:     cc tuck-out/app/__hello__/build/main.o tuck-out/lib/greet/__greet__/build/libgreet.a -o tuck-out/app/__hello__/build/hello"

testConstraint cc [expr {[auto_execok cc] ne ""}]

test example-build {the example builds and the binary runs} -constraints cc -setup {
    set ::savedpwd [pwd]
    cd $::exampledir
    file delete -force tuck-out
} -cleanup {
    file delete -force [file join $::exampledir tuck-out]
    cd $::savedpwd
} -body {
    lassign [run_example build //app:hello] code out
    if {$code != 0} { error "exit $code: $out" }
    list [lindex [split $out \n] end] \
         [exec [file join $::exampledir tuck-out app __hello__ build hello]]
} -result {tuck-out/app/__hello__/build/hello {Hello, world!}}

cleanupTests
