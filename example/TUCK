# Repo-global rule definitions for the example C project.
#
# Rules are defined only in the root TUCK file (loaded deterministically before
# any package). Each `tuck::rule` registers a constructor usable in BUILD files;
# its `impl` body runs during analysis and emits the action graph via `ctx`.
#
# Every file an action reads or writes is an artifact, and every command names
# files by their exec path (`ctx path`). That is what lets `tuck build` run each
# action in a sandbox that contains only the action's declared inputs.

rules {
    # --- path helpers --------------------------------------------------------
    #
    # These run inside the (safe) rules interpreter, where `file` is
    # unavailable, so they use plain string operations.

    # "a/b/c.h" -> "a/b"; a bare "c.h" -> "."
    proc dir_of {path} {
        if {[string first / $path] < 0} { return . }
        return [regsub {/[^/]*$} $path {}]
    }

    # "a/b/c.h" -> "c.h"
    proc base_of {path} {
        return [regsub {^.*/} $path {}]
    }

    # --- compile -------------------------------------------------------------
    #
    # Compile each C source to a private object file (an artifact dependents do
    # not see). $hdrs are the header artifacts the compile may include: they
    # become inputs, and their directories become -I flags. Returns the object
    # artifact ids. Helpers call `ctx` directly; it is bound to the target
    # being analysed.
    proc compile {srcs hdrs copts} {
        set incs {}
        foreach h $hdrs {
            set flag -I[dir_of [ctx path $h]]
            if {$flag ni $incs} { lappend incs $flag }
        }
        set objs {}
        foreach src $srcs {
            set base [regsub {\.c$} [base_of [ctx path $src]] {}]
            set obj [ctx declare_output build/$base.o -private]
            ctx action \
                inputs  [concat [list $src] $hdrs] \
                outputs [list $obj] \
                cmd     [concat [list cc] $copts $incs \
                             [list -c [ctx path $src] -o [ctx path $obj]]]
            lappend objs $obj
        }
        return $objs
    }

    # --- cc_library ----------------------------------------------------------
    #
    # Compile the sources and bundle the objects into a static archive. The
    # headers are copied to include/ and published alongside the archive, so a
    # dependent sees both through `ctx dep_outputs` and can compile against the
    # headers without reading anything it did not declare.
    tuck::rule cc_library {
        attrs {
            name  {type string  mandatory true}
            srcs  {type sources mandatory true}
            hdrs  {type sources mandatory false default {}}
            copts {type list    mandatory false default {}}
        }
        impl {
            set hdrs [ctx attr hdrs]
            set objs [compile [ctx attr srcs] $hdrs [ctx attr copts]]
            foreach h $hdrs {
                set pub [ctx declare_output include/[base_of [ctx path $h]]]
                ctx action inputs [list $h] outputs [list $pub] \
                    cmd [list cp [ctx path $h] [ctx path $pub]]
            }
            set lib [ctx declare_output build/lib[ctx attr name].a]
            set cmd [list ar rcs [ctx path $lib]]
            foreach o $objs { lappend cmd [ctx path $o] }
            ctx action inputs $objs outputs [list $lib] cmd $cmd
        }
    }

    # --- cc_binary -----------------------------------------------------------
    #
    # Compile the sources against the deps' published headers, then link the
    # objects with the deps' archives. Telling headers from archives by
    # extension is a stand-in for typed providers, a later milestone.
    tuck::rule cc_binary {
        attrs {
            name  {type string  mandatory true}
            srcs  {type sources mandatory true}
            deps  {type deps    mandatory false default {}}
            copts {type list    mandatory false default {}}
        }
        impl {
            set hdrs {}
            set libs {}
            foreach d [ctx attr deps] {
                foreach a [ctx dep_outputs $d] {
                    switch -glob -- [ctx path $a] {
                        *.h { lappend hdrs $a }
                        *.a { lappend libs $a }
                    }
                }
            }
            set objs [compile [ctx attr srcs] $hdrs [ctx attr copts]]
            set bin [ctx declare_output build/[ctx attr name]]
            set cmd [list cc]
            foreach o [concat $objs $libs] { lappend cmd [ctx path $o] }
            lappend cmd -o [ctx path $bin]
            ctx action inputs [concat $objs $libs] outputs [list $bin] cmd $cmd
        }
    }
}
